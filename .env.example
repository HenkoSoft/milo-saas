POSTGRES_DB=milo_dev
POSTGRES_USER=milo_dev
POSTGRES_PASSWORD=replace_with_a_local_random_password
DATABASE_URL=postgresql://milo_dev:replace_with_a_local_random_password@localhost:5432/milo_dev?schema=public

# Server-only. Set these in your local environment; never commit real secrets.
# Required. Production requires HTTPS. HTTP is allowed only for localhost or
# loopback addresses with NODE_ENV=development (as set by next dev).
BETTER_AUTH_URL=http://localhost:3000
# Required: at least 32 characters, random, with no surrounding whitespace.
# Known placeholders and repeated-character values are rejected.
# Generate independently, e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
